# ===============================
# CONFIGURACIÓN GENERAL
# ===============================
RewriteEngine On

# Usar index.php como página principal
DirectoryIndex index.php index.html
AcceptPathInfo Off


# ===============================
# DESARROLLO LOCAL
# ===============================

# Redirigir HTTPS a HTTP SOLO en localhost
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:.*)?$ [NC]
RewriteRule ^(.*)$ http://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# ===============================
# DOMINIO CANÓNICO EN PRODUCCIÓN
# https://industrialcollectors.com
# ===============================

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:.*)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^industrialcollectors\.com$ [NC]
RewriteRule ^ https://industrialcollectors.com%{REQUEST_URI} [R=301,L,NE]


# ===============================
# EVITAR INDEX.PHP / INDEX.HTML
# COMO URLs DUPLICADAS
# ===============================

RewriteCond %{HTTP_HOST} ^industrialcollectors\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.(php|html?)([\s?]|$) [NC]
RewriteRule ^index\.(php|html?)$ https://industrialcollectors.com/ [R=301,L,NE,QSD]


# ===============================
# PREVENIR ACCESO A ARCHIVOS SENSIBLES
# ===============================

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|backup)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>


# ===============================
# DIRECTORIOS INTERNOS
# ===============================

RewriteRule ^(?:config|logs|storage|tests|tools|\.agents)(?:/|$) - [F,L,NC]


# ===============================
# CABECERAS DE SEGURIDAD
# ===============================

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>


# ===============================
# SEGURIDAD DE DIRECTORIOS
# ===============================

Options -Indexes
ServerSignature Off


# ===============================
# COMPRESIÓN GZIP
# ===============================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>


# ===============================
# CACHE
# ===============================

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>
